PORT=5000
# Local MongoDB, or paste your MongoDB Atlas connection string here
MONGO_URI=mongodb://127.0.0.1:27017/unievents
# Any long random string (required - the server will not start without it)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Frontend origin(s), comma separated. Wildcards allowed, e.g. https://*.vercel.app
CLIENT_URL=http://localhost:5173
# E-mail domains allowed to create a student account
UNIVERSITY_DOMAINS=bbdu.ac.in,gmail.com
# Demo mode: show the password-reset link on screen because no mail server is configured
DEMO_RESET_LINKS=true
NODE_ENV=development
